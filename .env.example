# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Admin Auth
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_jwt_secret_key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Mailchimp (optional)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxx-us1
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxxxx

# Public API base URL (leave empty on Vercel — Next.js handles routing)
# NEXT_PUBLIC_API_URL=
